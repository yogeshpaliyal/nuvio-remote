{
  "version": 1,
  "about": "How Skiff opens links on the TV. The first rule whose match fits the link is used; a link no rule matches is sent as it is to whichever TV app opens it. See RULES.md.",
  "rules": [
    {
      "id": "hotstar",
      "name": "JioHotstar",
      "match": { "hosts": ["hotstar.com", "jiohotstar.com"], "schemes": ["hotstar"] },
      "rewrite": { "from": "^https?://(?:www\\.)?(?:jio)?hotstar\\.com/", "to": "hotstar://" },
      "packages": ["in.startv.hotstar"],
      "flags": ["NEW_TASK", "CLEAR_TASK"],
      "title": "slug"
    },
    {
      "id": "youtube",
      "name": "YouTube",
      "match": { "hosts": ["youtube.com", "youtu.be", "m.youtube.com"] },
      "packages": ["com.google.android.youtube.tv"],
      "flags": ["NEW_TASK", "CLEAR_TASK"],
      "title": "oembed:https://www.youtube.com/oembed?format=json&url={link}"
    },
    {
      "id": "airtel-xstream",
      "name": "Airtel Xstream",
      "match": { "schemes": ["xstream"] },
      "packages": ["tv.airtel.xstream.tvapp"],
      "flags": ["NEW_TASK", "CLEAR_TASK"]
    },
    {
      "id": "netflix",
      "name": "Netflix",
      "match": { "hosts": ["netflix.com"], "schemes": ["nflx"] },
      "packages": ["com.netflix.ninja"],
      "flags": ["NEW_TASK", "CLEAR_TASK"],
      "title": "og"
    },
    {
      "id": "prime-video",
      "name": "Prime Video",
      "match": { "hosts": ["primevideo.com", "amazon.in", "amazon.com"] },
      "packages": ["com.amazon.amazonvideo.livingroom"],
      "flags": ["NEW_TASK", "CLEAR_TASK"],
      "title": "og"
    }
  ],
  "apps": {
    "in.startv.hotstar": "JioHotstar",
    "com.google.android.youtube.tv": "YouTube",
    "com.google.android.youtube.tvmusic": "YouTube Music",
    "com.netflix.ninja": "Netflix",
    "com.amazon.amazonvideo.livingroom": "Prime Video",
    "tv.airtel.xstream.tvapp": "Airtel Xstream",
    "com.disney.disneyplus": "Disney+",
    "com.spotify.tv.android": "Spotify",
    "com.nuvio.tv": "Nuvio",
    "com.nuvio.app": "Nuvio"
  }
}
